## Client-side env vars (Vite)
# IMPORTANT: Vite only exposes variables prefixed with VITE_ to the browser.

# Backend API base URL (include /api/v1).
# Local development: use the local backend. Do not point localhost at Render.
VITE_API_BASE_URL=http://localhost:5001/api/v1
# Production: configure https://admiino-backend.onrender.com/api/v1 in Vercel;
# do not commit a production value into a local env file.

# Google Picker API — browser-safe API key (NOT the OAuth client secret).
# Required for the Google Picker dialog on desktop.
# Obtain from Google Cloud Console → APIs & Services → Credentials → API Keys.
# Restrict the key to the "Google Picker API" and your app's origin.
# NEVER put the OAuth client secret here.
VITE_GOOGLE_API_KEY=

# Cloudflare Turnstile site key (public). The matching SECRET key is backend-only (TURNSTILE_SECRET_KEY).
# Leave empty for local development when using the local backend with
# TURNSTILE_DEV_BYPASS=true and NODE_ENV=development. Never set that bypass in production.
# Alternatively use Cloudflare's official test site key with a development backend test secret.
VITE_TURNSTILE_SITE_KEY=
